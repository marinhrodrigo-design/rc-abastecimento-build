      type:'${x['tipo']??x['type']??''}',location:'${x['localizacao']??x['location']??''}',active:false,
      comboioCapacityLiters:x['comboio_capacity_liters']==null?null:_num(x['comboio_capacity_liters']),fuelTankCapacityLiters:x['fuel_tank_capacity_liters']==null?null:_num(x['fuel_tank_capacity_liters']),
      measurementType:'${x['measurement_type']??'none'}'.trim().isEmpty?'none':'${x['measurement_type']}',
    );
  }
"""
new_archive="""  Future<void> archiveMachine(Map<String,dynamic> x) async {
    final id=_intOrNull(x['id']);if(id==null)throw Exception('Ativo inválido');
    await client.rpc('rca_archive_machine_v68',params:{'p_id':id});

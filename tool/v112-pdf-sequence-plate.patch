+String _officialPdfFileNameV112(List<Map<String, dynamic>> items) {
+  if (items.isEmpty) return 'R&C-Abastecimento.pdf';
+  final first = items.first;
+  final fueling = '${first['type'] ?? ''}' == 'fueling';
+  if (items.length == 1 && fueling) {
+    final origin = _recordOriginV28(first)
+        .replaceAll(RegExp(r'[^A-Za-z0-9_-]+'), '-')
+        .replaceAll(RegExp(r'^-+|-+$'), '');
+    final sequence = _recordSequenceV28(first);
+    return 'R&C-Abastecimento-${origin.isEmpty ? 'UNIDADE' : origin}-$sequence.pdf';
+  }
+  return 'R&C-Abastecimento-${items.length}-registros.pdf';
+}

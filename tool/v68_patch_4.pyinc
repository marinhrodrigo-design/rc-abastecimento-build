      if(mounted)setState((){profile=p;loading=false;});_startSessionGuardV30();unawaited(offlineStore.syncPending(force:true));
""",
"""      await offlineStore.reconcileAbandonedSessionV68();
      final claim=await _claimSessionV42(explicitLogin:true);if(claim['ok']!=true)throw Exception('${claim['message']??'Não foi possível registrar esta sessão.'}');
      final p=await api.profile();offlineStore.markOnline();await offlineStore.cacheProfile(p);await offlineStore.cacheFuelingPermissionV68(p['can_fueling_create']==true);await offlineStore.cacheOfflineLoginV62(normalized,password,p);await api.referenceData();await offlineStore.beginSessionMarkerV68();
      if(mounted)setState((){profile=p;loading=false;});_startSessionGuardV30();unawaited(offlineStore.syncPending(force:true));
""",

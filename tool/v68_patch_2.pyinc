              if('${q['id']}'=='${queued['id']}'){
                q['sync_error']='${response['message']??'Sincronização aguardando revisão.'}';
                q['sync_blocked']=true;
                q['sync_conflict']=response['conflict']==true;
                q['sync_status']=response['status'];

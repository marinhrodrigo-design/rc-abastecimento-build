+String _fuelUnitPlateV112(Map<String, dynamic> unit,
+    [Map<String, dynamic>? referenceData]) {
+  final ref = referenceData ?? offlineStore.cachedReferenceData;
+  final requestedId = _intOrNull(unit['id'] ??
+      unit['tank_id'] ??
+      unit['source_tank_id'] ??
+      unit['destination_tank_id']);
+  final requestedCode = _firstTextV111([
+    unit['code'],
+    unit['unit_code'],
+    unit['tank_code'],
+    unit['source_code'],
+    unit['source_tank_code'],
+    unit['source_tank'],
+    unit['destination_code'],
+    unit['destination_tank_code'],
+  ]);
+
+  Map<String, dynamic>? tank;
+  if (ref != null) {
+    for (final x in _rows(ref['tanks'])) {
+      final sameId = requestedId != null && _intOrNull(x['id']) == requestedId;
+      final code = _firstTextV111([x['code']]);
+      final sameCode = requestedCode.isNotEmpty &&
+          code.isNotEmpty &&
+          code.toUpperCase() == requestedCode.toUpperCase();
+      if (sameId || sameCode) {
+        tank = x;
+        break;
+      }
+    }
+  }
+
+  final source = tank ?? unit;
+  String plate = _firstTextV111([
+    source['plate'],
+    source['placa'],
+    unit['plate'],
+    unit['placa'],
+  ]);
+
+  final machineId = _intOrNull(source['machine_id'] ?? unit['machine_id']);
+  if (ref != null && machineId != null) {
+    for (final x in _rows(ref['machines'])) {
+      if (_intOrNull(x['id']) != machineId) continue;
+      plate = _firstTextV111([x['placa'], plate]);
+      break;
+    }
+  }
+
+  final thirdPartyId = _intOrNull(
+      source['third_party_vehicle_id'] ?? unit['third_party_vehicle_id']);
+  if (ref != null && thirdPartyId != null) {
+    for (final x in _rows(ref['third_party_vehicles'])) {
+      if (_intOrNull(x['id']) != thirdPartyId) continue;
+      plate = _firstTextV111([x['plate'], plate]);
+      break;
+    }
+  }
+  return plate;
+}

# final hard checks
for path in [main,v29,v31]:
    text=path.read_text(encoding='utf-8')
    if 'Sem placa' in text:
        raise SystemExit(f'PATCH_V68_FAIL[sem_placa_remaining]: {path}')

m=main.read_text(encoding='utf-8')
checks=[
    'rca_record_fueling_v68',
    'rca_archive_machine_v68',
    'can_fueling_create_v68',
    'beginSessionMarkerV68',
    'GPS indisponível no momento da conclusão',
    "meterPhoto:u[0]",
    "child: Text('v68'",
]
for c in checks:
    if c not in m: raise SystemExit(f'PATCH_V68_FAIL[check]: {c}')
if 'meterPhoto:u[0]!' in m: raise SystemExit('PATCH_V68_FAIL[nullable_meter]')
print('PATCH_V68_PLAIN_OK')

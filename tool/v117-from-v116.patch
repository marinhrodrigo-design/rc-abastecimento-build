+String _fmtLitersBrV117(dynamic value) {
+  final fixed = _num(value).toStringAsFixed(1);
+  final parts = fixed.split('.');
+  final negative = parts.first.startsWith('-');
+  final digits = negative ? parts.first.substring(1) : parts.first;
+  final groups = <String>[];
+  for (var end = digits.length; end > 0; end -= 3) {
+    final start = max(0, end - 3);
+    groups.insert(0, digits.substring(start, end));
+  }
+  final integer = '${negative ? '-' : ''}${groups.join('.')}';
+  return '$integer,${parts.length > 1 ? parts[1] : '0'} L';
+}
